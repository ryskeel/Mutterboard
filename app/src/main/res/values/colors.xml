    <!-- Keyboard (IME) brand fallback, used when the device has no dynamic
         color to override it. Mirrors the settings screen's monochrome chrome
         (see ui/theme/Color.kt) so the keyboard buttons and the equalizer match
         the rest of the app. Dark equivalents live in values-night/colors.xml. -->
    <color name="brand_kb_primary">#FF1A1A1A</color>
    <color name="brand_kb_on_primary">#FFFFFFFF</color>
    <color name="brand_kb_secondary_container">#FFE6E6E6</color>
    <color name="brand_kb_on_secondary_container">#FF1A1A1A</color>

    <!-- The header keycap mark (ic_mutterboard_mark): a dark key on light. -->
    <color name="mark_cap">#FF1A1A1A</color>
    <color name="mark_face">#FF333333</color>
    <color name="mark_ink">#FFFFFFFF</color>
</resources>
