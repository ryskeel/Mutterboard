<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the least this service can get away with. It reads window content
  (needed to find the focused text field) but subscribes to almost no events,
  because nothing here is event-driven: the overlay calls in on demand when a
  transcript is ready.

  It deliberately does NOT ask for the accessibility button
  (flagRequestAccessibilityButton). Asking makes Settings treat the service as
  one you invoke with the button, and it drops the "Use Mutterboard Dictate"
  switch from the service's own page - leaving the shortcut toggle as the only
  way to turn on the permission that makes pasting work. Verified both ways on a
  Titan II. Whatever the button is worth, it is not worth being unable to enable
  the service without it.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
