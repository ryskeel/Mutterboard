<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the least this service can get away with. It reads window content
  (needed to find the focused text field) but subscribes to almost no events,
  because nothing here is event-driven: the overlay calls in on demand when a
  transcript is ready.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
